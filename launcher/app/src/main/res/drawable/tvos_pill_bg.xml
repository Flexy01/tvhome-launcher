<?xml version="1.0" encoding="utf-8"?>
<!-- tvOS 27 compact clock-profile capsule: Smoked dark glass at rest, solid bright white when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F7FFFFFF" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#596EC1FF" />
            <stroke android:width="1.5dp" android:color="#FF6EC1FF" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#6614161C" />
            <stroke android:width="0.75dp" android:color="#33FFFFFF" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</selector>
